# Server Configuration
PORT=3001

# Google Gemini API
GEMINI_API_KEY="your_google_ai_studio_api_key_here"

# Supabase Storage (Audio Temporary Storage & DB)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_KEY="your_supabase_service_role_key_here"

# TTS VOXCPM Service (Optional Local Voice Pipeline)
TTS_SERVICE_URL="http://localhost:8000"

# Ollama (Optional Local LLM)
OLLAMA_BASE_URL=http://localhost:11434

# Modal Cloud Pipeline (Default Voice Provider)
MODAL_INTERACT_URL=
MODAL_TRANSCRIBE_URL=
MODAL_TTS_URL_CHAR1=
MODAL_TTS_URL_CHAR2=
MODAL_WAKE_AGENT_URL=

# RunPod Alternative Pipeline
# Switch with VOICE_PIPELINE_PROVIDER=runpod (default: modal)
VOICE_PIPELINE_PROVIDER=modal
RUNPOD_INTERACT_URL=
RUNPOD_TTS_URL_CHAR1=
RUNPOD_WAKE_AGENT_URL=

# Internal API Secret (Used by Modal/RunPod worker to fetch session context)
# Generate with: openssl rand -hex 32
INTERNAL_API_KEY=your_random_secret_here

# LiveKit Credentials
LIVEKIT_URL=wss://your-livekit-instance.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
